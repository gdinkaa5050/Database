-- 1. Account status and lock time
SELECT username, account_status, lock_date, last_login, profile
FROM dba_users
WHERE username = 'USERNAME';

-- 2. Lockout threshold
SELECT p.resource_name, p.limit
FROM dba_profiles p
JOIN dba_users u ON u.profile = p.profile
WHERE u.username = 'USERNAME'
AND p.resource_name IN ('FAILED_LOGIN_ATTEMPTS','PASSWORD_LOCK_TIME');

-- 3. How many failed login attempts (1017 = wrong password, 28000 = tried while locked)
SELECT return_code, COUNT(*) AS attempts,
       MIN(event_timestamp) AS first_try,
       MAX(event_timestamp) AS last_try
FROM unified_audit_trail
WHERE dbusername = 'USERNAME'
AND action_name = 'LOGON'
AND return_code <> 0
GROUP BY return_code;

-- 4. Where the attempts came from
SELECT userhost, os_username, client_program_name,
       return_code, COUNT(*) AS attempts
FROM unified_audit_trail
WHERE dbusername = 'USERNAME'
AND action_name = 'LOGON'
AND return_code <> 0
GROUP BY userhost, os_username, client_program_name, return_code
ORDER BY attempts DESC;

-- 5. Each failed attempt with its time
SELECT event_timestamp, userhost, os_username,
       client_program_name, return_code
FROM unified_audit_trail
WHERE dbusername = 'USERNAME'
AND action_name = 'LOGON'
AND return_code <> 0
ORDER BY event_timestamp DESC;

-- 6. Unlock the account (run after fixing the source)
ALTER USER USERNAME ACCOUNT UNLOCK;
